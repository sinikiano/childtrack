# Network
PORT=8080
HOST=127.0.0.1

# Storage
DB_PATH=./data/childtrack.db

# Keep this many days of location history / geocode cache (purged daily)
RETENTION_DAYS=90

# Devices: name:token,name:token   (generate token with: openssl rand -hex 32)
DEVICES=alice:REPLACE_WITH_LONG_RANDOM_TOKEN,bob:REPLACE_WITH_ANOTHER_TOKEN

# Bootstrap admin (auto-created on first start if no users exist)
DASH_USER=parent
DASH_PASS=change-me-now

# Session lifetime (days)
SESSION_DAYS=30

# Trust proxy (1 if behind nginx)
TRUST_PROXY=1

# --- Notifications (any/all are optional) ---------------------------------
# ntfy: self-host on your VPS or use https://ntfy.sh/<random-topic>
NOTIFY_NTFY_URL=

# Telegram: create a bot via @BotFather, then start a chat with it.
# Get chat id from https://api.telegram.org/bot<token>/getUpdates
NOTIFY_TELEGRAM_BOT_TOKEN=
NOTIFY_TELEGRAM_CHAT_ID=

# Reverse geocoding via Nominatim (be respectful — set a real contact UA).
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_UA=ChildTrack/0.2 (you@example.com)
