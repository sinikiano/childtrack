# Append to /etc/fail2ban/jail.local then:  systemctl reload fail2ban
# Requires nginx access logs in combined format at /var/log/nginx/access.log

[childtrack]
enabled  = true
port     = http,https
filter   = childtrack
logpath  = /var/log/nginx/access.log
maxretry = 8
findtime = 600
bantime  = 3600
