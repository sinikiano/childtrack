[Unit]
Description=ChildTrack server
After=network.target

[Service]
Type=simple
User=childtrack
WorkingDirectory=/opt/childtrack/server
EnvironmentFile=/opt/childtrack/server/.env
ExecStart=/usr/bin/node src/index.js
Restart=on-failure
RestartSec=3
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
